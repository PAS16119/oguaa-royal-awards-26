# Postgres connection string from Neon (via Vercel Marketplace or neon.tech directly)
DATABASE_URL="postgres://user:password@ep-xxxx.neon.tech/oguaa?sslmode=require"

# Auto-filled by Vercel when you add the Blob storage integration —
# you normally never type this yourself.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Any long random string — used to sign admin/agent session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# ---- Paystack (only needed if you want people to buy codes online) ----
# Dashboard -> Settings -> API Keys & Webhooks. Use the TEST keys first.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---- USSD voting (only needed once you have an Arkesel shortcode) ----
# Any long random string. Set the same value in the Arkesel dashboard by
# appending it to your callback URL as ?key=... — see USSD_SETUP_GUIDE.md.
# Optional: if unset, the USSD webhook accepts any request (fine for
# testing in the Arkesel simulator, not for going live).
USSD_WEBHOOK_SECRET="replace-with-another-long-random-string"
